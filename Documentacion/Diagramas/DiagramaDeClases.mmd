classDiagram

    Usuario <-- Administrador : Hereda de
    Usuario -- BienDeAlquiler
    Usuario -- Renta
    Usuario -- ReporteDaños
    Usuario -- Plantilla

    Renta -- Evento

    ModeloBienDeAlquiler -- BienDeAlquiler


    class Usuario{
        + IniciarSesion() void
        + RegistrarNuevoModelo(modeloBienDeAlquiler) void
        + ObtenerModeloBienDeAlquiler(modelo : ModeloBienDeAlquiler) ModeloBienDeAlquiler
        + ObtenerBienPorFolio(folio : String) BienDeAlquiler
        + ObtenerRenta(renta : Renta) Renta
        + CrearPlantilla( modelos : List ModeloBienDeAlquiler) void
        + ObtenerReporteDaños(reporte : ReporteDaños) ReporteDaños
    }

    class Administrador{
        + CrearNuevoUsuario(usuario : Usuario) void
        + EliminarUsuario(usuario : Usuario) void
    }

    class ModeloBienDeAlquiler{
        - m_nombre : String
        - m_categoria : enum
        - m_bienes : ArrayList BienDeAlquiler
    }


    class BienDeAlquiler{
        - m_folio : String
        - m_estado : enum
    }


    class Renta{
        - m_evento : Evento
        - m_bienesRentados : ArrayList BienDeAlquiler
        - m_horaMontaje : Hora
        - m_horaDesmontaje : Hora
    }

    class Evento{
        - m_nombreEvento : String
        - m_direccion : Direccion        
        - m_inicioFechaYHora : FechaYHora
        - m_finalFechaYHora : FechaYHora        
    }

    class ReporteDaños{
        - m_fecha : Fecha
        - m_bienDeAlquiler : BienDeAlquiler
        - m_descripcionDaño : String
        - m_prioridad : enum
        - m_renta : Renta
    }


    class Plantilla{
        - m_bienesDeAlquiler : ArrayList BienDeAlquiler
    }
