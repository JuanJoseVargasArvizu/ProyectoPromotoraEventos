classDiagram



class BienDeAlquiler{
    - m_folio : int
    - m_nombre : String
    - m_precio : double
    - m_cantidadEnAlmacen : int
    + RestarAlmacen(cantidad : int) void
    + AumentarAlmacen(cantidad : int) void
}

class CompraDeBienes{
    - m_bienComprado : BienDeAlquiler
    - m_cantidad : int
    - m_costo : double
    - m_fecha : Fecha
}

class ReportesNegocio{
    - m_reportesInventario : ArrayList ReporteMensualInventario
    - m_reportesRenta : ArrayList ReporteMensualRentas
}

class ReporteMensualInventario{
    - m_mes : int
    - m_año : int
    - m_comprasDeBienes : ArrayList CompraDeBienes
}

class ReporteMensualRentas{
    - m_mes : int
    - m_año : int
    - m_rentas : ArrayList Renta
}

class Renta{
    - m_bienesRentados : ArrayList BienDeAlquiler
    - m_fecha : Fecha
    - m_direccion : Direccion
    - m_cliente : Cliente
}

class Cliente{
    - m_nombre : String
    - m_contacto : Telf
}